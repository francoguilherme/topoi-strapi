{
    "kind": "collectionType",
    "collectionName": "artigos",
    "info": {
        "singularName": "artigo",
        "pluralName": "artigos",
        "displayName": "Artigo"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "titulo": {
            "type": "string",
            "required": true
        },
        "titulo_en": {
            "type": "string"
        },
        "titulo_es": {
            "type": "string"
        },
        "slug": {
            "type": "uid",
            "targetField": "titulo",
            "required": false
        },
        "resumo": {
            "type": "blocks"
        },
        "resumo_en": {
            "type": "blocks"
        },
        "resumo_es": {
            "type": "blocks"
        },
        "arquivo": {
            "type": "media",
            "multiple": false,
            "required": true,
            "allowedTypes": [
                "files"
            ]
        },
        "palavras_chave": {
            "type": "component",
            "component": "simples.texto",
            "repeatable": true
        },
        "autores": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::autor.autor",
            "mappedBy": "artigos"
        },
        "pagina_inicial": {
            "type": "integer"
        },
        "pagina_final": {
            "type": "integer"
        },
        "secao": {
            "type": "enumeration",
            "required": true,
            "default": "Artigo",
            "enum": [
                "Artigo",
                "Resenha",
                "Entrevista",
                "Documento"
            ]
        },
        "dossie": {
            "type": "boolean",
            "required": true
        },
        "edicao": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::edicao.edicao",
            "inversedBy": "artigos"
        },
        "traducao": {
            "type": "boolean",
            "default": false
        },
        "tradutores": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::autor.autor",
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "traducao"
                        },
                        true
                    ]
                }
            },
            "mappedBy": "artigos_traduzidos"
        },
        "anotacao": {
            "type": "string"
        },
        "data_de_publicacao": {
            "type": "date"
        },
        "doi": {
            "type": "string"
        }
    }
}
