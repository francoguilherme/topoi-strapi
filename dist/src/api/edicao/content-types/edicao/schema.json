{
    "kind": "collectionType",
    "collectionName": "edicoes",
    "info": {
        "singularName": "edicao",
        "pluralName": "edicoes",
        "displayName": "Edição"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "volume": {
            "type": "integer",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "required": true
        },
        "numero": {
            "type": "integer",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "titulo": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "unique": true
        },
        "descricao": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "periodo": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "required": false,
            "regex": "^(\\d{4})$|(^([a-zA-ZçÇ]+)\\s+-\\s+([a-zA-ZçÇ]+)\\s+(\\d{4})$)"
        },
        "data_de_publicacao": {
            "type": "date",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "apresentacao": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "multiple": false,
            "allowedTypes": [
                "files"
            ]
        },
        "capa": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "artigos": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::artigo.artigo",
            "mappedBy": "edicao"
        },
        "editorial": {
            "type": "component",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "component": "simples.editorial",
            "repeatable": false
        },
        "titulo_composto": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            },
            "required": false,
            "unique": true
        }
    }
}
